# Environment variables for SukoonRoute

# App Environment
NEXT_PUBLIC_APP_NAME="SukoonRoute"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Database, Auth, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"

# Maps / OpenStreetMap
NEXT_PUBLIC_OPENSTREETMAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# SMS & WhatsApp SOS Trigger (Twilio / Gupshup / Exotel stub for emergency SOS)
TWILIO_ACCOUNT_SID="your_twilio_sid_placeholder"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_placeholder"
TWILIO_PHONE_NUMBER="+1234567890"

# Email Verification (Resend / SendGrid placeholder)
RESEND_API_KEY="re_placeholder_123"
